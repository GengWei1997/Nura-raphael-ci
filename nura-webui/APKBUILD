# Reference: <https://postmarketos.org/APKBUILD>
maintainer="GengWei1997 <gw19970326@gmail.com>"
pkgname=nura-webui
pkgver=1.0
pkgrel=0
pkgdesc="Web management panel for the Xiaomi Redmi K20 Pro (xiaomi-raphael)"
url="https://github.com/GengWei1997/Nura-xiaomi-raphael"
arch="noarch"
license="MIT"
depends="python3 nftables"
source="
	server.py
	index.html
	nura-webui.service
	90-nura-webui.preset
	60_nura-webui.nft
	nura-webui.sudoers
	blank_screen.service
	nura-cpufreq
	nura-webui.post-install
	nura-webui.post-upgrade
"
# apk 每次事务只跑 post-install 或 post-upgrade 其中一个，两个都要打进去。
install="$pkgname.post-install $pkgname.post-upgrade"
options="!check !fhs"

package() {
	install -Dm755 "$srcdir"/server.py "$pkgdir"/usr/share/nura-webui/server.py
	install -Dm644 "$srcdir"/index.html "$pkgdir"/usr/share/nura-webui/index.html

	install -Dm644 "$srcdir"/nura-webui.service \
		"$pkgdir"/usr/lib/systemd/system/nura-webui.service
	# 99-default.preset ships "disable *", so the unit needs its own preset.
	install -Dm644 "$srcdir"/90-nura-webui.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/90-nura-webui.preset
	install -Dm644 "$srcdir"/60_nura-webui.nft \
		"$pkgdir"/etc/nftables.d/60_nura-webui.nft
	# Shipped in /usr/lib so a unit the device already has in /etc/systemd/system
	# keeps winning; new devices get it from here and the toggle works out of
	# the box. Enabling it is still the panel's job, not the package's.
	install -Dm644 "$srcdir"/blank_screen.service \
		"$pkgdir"/usr/lib/systemd/system/blank_screen.service
	# Grants exactly the commands the panel needs, nothing else.
	install -Dm440 "$srcdir"/nura-webui.sudoers \
		"$pkgdir"/etc/sudoers.d/nura-webui
	# Validates the frequency itself before touching sysfs.
	install -Dm755 "$srcdir"/nura-cpufreq \
		"$pkgdir"/usr/libexec/nura-cpufreq
}

